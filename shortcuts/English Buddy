#!/data/data/com.termux/files/usr/bin/bash
# 서버가 꺼져 있으면 뒤에서 켜고(최신 버전 자동 반영), 앱 화면을 연다.
# 서버는 계속 켜두되 Claude 는 대화할 때만 돌아서 대기 중엔 배터리를 거의 안 쓴다.
URL=http://localhost:8787
if ! curl -s -m 2 $URL/api/status >/dev/null; then
  echo "English Buddy 켜는 중..."
  rm -f ~/.english-buddy-off
  proot-distro login debian -- git -C /root/english-tutor pull -q >/dev/null 2>&1
  # 서버가 죽으면 자동으로 다시 켠다 (끄기 아이콘을 누르면 멈춤)
  nohup bash -c 'while true; do proot-distro login debian -- bash -c "cd ~/english-tutor && node server.js"; [ -f ~/.english-buddy-off ] && break; sleep 2; done' > ~/tutor.log 2>&1 &
  for i in $(seq 1 40); do curl -s -m 1 $URL/api/status >/dev/null && break; sleep 1; done
fi
termux-open-url $URL
